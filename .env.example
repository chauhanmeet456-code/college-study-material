# ==============================================================================
# StudyHub Configuration Template (.env.example)
# Copy this file to .env and adjust variables for your local development or Render environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Production PostgreSQL (Render):
# Set DATABASE_URL to your managed PostgreSQL connection string (e.g. Neon, Supabase, Render Postgres)
DATABASE_URL=

# Set DATABASE_BACKEND=postgresql to require a local PostgreSQL URL and fail clearly if it is missing.
# Leave unset for automatic selection, or choose sqlite/mysql explicitly.
DATABASE_BACKEND=

# Local Development PostgreSQL (Windows / Localhost):
# Use DEV_DATABASE_URL (or LOCAL_DATABASE_URL) so local runs do not depend on remote DNS/network.
# When DEV_DATABASE_URL is set and not running on Render, StudyHub automatically prioritizes it.
DEV_DATABASE_URL=postgresql://postgres:your_local_password@localhost:5432/college_study

# Alternatively, configure discrete PostgreSQL environment variables:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_local_password
# PGDATABASE=college_study

# SQLite local testing flag (set to true only for offline lightweight dev without PostgreSQL):
USE_SQLITE=false

# Explicit MySQL configuration (used when DB_* settings are supplied and no PostgreSQL/SQLite backend is selected):
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=college_study
# DB_USER=root
# DB_PASSWORD=your_password

# ------------------------------------------------------------------------------
# 2. UPLOAD & PERSISTENT STORAGE
# ------------------------------------------------------------------------------
# Render persistent disk mount or custom local directory.
# Defaults to static/uploads inside the project if left empty.
# In production on Render with a Persistent Disk at /var/data:
# UPLOAD_FOLDER=/var/data/uploads
UPLOAD_FOLDER=

# ------------------------------------------------------------------------------
# 3. FLASK / APPLICATION SETTINGS
# ------------------------------------------------------------------------------
SECRET_KEY=your_secret_key_here_change_in_production
APP_NAME=StudyHub
FLASK_DEBUG=false

# Public origin used for canonical/social URLs, OAuth callbacks, and sitemaps.
# Production: https://college-study-material.onrender.com
# Local development: http://localhost:5000
PUBLIC_BASE_URL=

# Set true when serving the site over HTTPS. Render enforces Secure cookies automatically.
SESSION_COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 (Optional until Google sign-in is configured)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 5. EMAIL / SMTP CONFIGURATION (For OTP & notifications)
# ------------------------------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_TIMEOUT=10
MAIL_CONNECT_TIMEOUT=3
MAIL_SEND_TIMEOUT=8

# ------------------------------------------------------------------------------
# 6. OTP & AUTH SETTINGS (Optional, sensible defaults applied if omitted)
# ------------------------------------------------------------------------------
OTP_EXPIRY_SECONDS=300
OTP_MAX_RESENDS=3
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_VERIFICATION_ATTEMPTS=5

# ------------------------------------------------------------------------------
# 7. SESSION MANAGEMENT & SECURITY
# ------------------------------------------------------------------------------
MAX_ACTIVE_SESSIONS_PER_USER=1
SESSION_LIFETIME_MINUTES=720
SESSION_IDLE_TIMEOUT_MINUTES=60
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW=900

# ------------------------------------------------------------------------------
# 8. BACKGROUND NOTIFICATION WORKER
# ------------------------------------------------------------------------------
NOTIFICATION_POLL_INTERVAL=15
NOTIFICATION_WORKER_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_SECONDS=60
NOTIFICATION_RETRY_MAX_SECONDS=3600
NOTIFICATION_PROCESSING_LEASE_SECONDS=300
