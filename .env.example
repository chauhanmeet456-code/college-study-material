# Database Configuration
# For PostgreSQL/NeonDB, set DATABASE_URL to your connection string.
# Explicit USE_SQLITE=true takes priority over DATABASE_URL.
DATABASE_URL=

# Set true to select SQLite; otherwise DATABASE_URL selects PostgreSQL.
USE_SQLITE=false

# MySQL fallback (used when neither DATABASE_URL nor USE_SQLITE is configured)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=college_study
DB_USER=root
DB_PASSWORD=your_password

# Flask / Session
SECRET_KEY=your_secret_key_here_change_in_production
APP_NAME=StudyHub

# Email Configuration (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_TIMEOUT=10
MAIL_CONNECT_TIMEOUT=3
MAIL_SEND_TIMEOUT=8

# OTP Settings (optional, defaults shown)
OTP_EXPIRY_SECONDS=300
OTP_MAX_RESENDS=3
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_VERIFICATION_ATTEMPTS=5

# Durable notification worker (run separately from Flask)
NOTIFICATION_POLL_INTERVAL=15
NOTIFICATION_WORKER_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_SECONDS=60
NOTIFICATION_RETRY_MAX_SECONDS=3600
NOTIFICATION_PROCESSING_LEASE_SECONDS=300

# Session Management (optional, defaults shown)
MAX_ACTIVE_SESSIONS_PER_USER=1
SESSION_LIFETIME_MINUTES=720
SESSION_IDLE_TIMEOUT_MINUTES=60
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW=900

# Security (optional, defaults shown)
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false
